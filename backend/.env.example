# Microsoft Foundry (optional). Leave AZURE_AI_PROJECT_ENDPOINT empty to run every agent
# against the built-in fake client: tests, CI and offline demos need no Azure access.
# When set, the agents call this Foundry project's model deployment. Auth is identity-based
# (DefaultAzureCredential): your `az login` locally, the app's managed identity in Azure.
# scripts/azure/provision.sh creates the deployment and fills these in backend/.env.
# Check it with: uv run python -m formline.agents.llm --smoke
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Replay speed: simulated match seconds per real second.
SIM_SPEED=10

# Origins allowed to call the API (the viewer).
CORS_ORIGINS=["http://localhost:3000"]
